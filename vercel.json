{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://neev-ai-ri5z.onrender.com/api/:match*"
    },
    {
      "source": "/static/:match*",
      "destination": "/public/:match*"
    },
    {
      "source": "/favicon.ico",
      "destination": "/public/favicon.svg"
    },
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
